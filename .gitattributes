# GitHub's language statistics (Linguist) classify SQL as a "data" language and
# exclude data languages by default — which made this repo report as 100% Python
# even though the scoring methodology lives entirely in sql/. Mark SQL as
# detectable so it is counted and shown.
*.sql linguist-detectable

# docs/index.html is generated by build_dashboard.py: a 4 MB file whose data is
# embedded on a few enormous lines. Flagging it keeps it out of language stats
# and collapses it in pull request diffs, where it is unreadable anyway.
docs/index.html linguist-generated

# Committed analysis outputs are results, not source.
outputs/*.csv linguist-generated
